# 关键：shell 脚本在 macOS runner 上必须是 LF，
# 否则会报 `$/bin/bash: $\r: command not found` 这种鬼错误。
*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.dart          text eol=lf
*.md            text eol=lf
*.plist         text eol=lf
*.json          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 图片是二进制，别让 git 以为是文本
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ipa           binary
